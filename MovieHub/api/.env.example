# MongoDB Atlas connection string. Keep the real value only in .env.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Database used for the sample movie data and MovieHub accounts.
MOVIE_DB_NAME=sample_mflix
APP_DB_NAME=moviehub

# Create a long, random secret. Example PowerShell command:
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=replace-with-a-long-random-secret

PORT=3000
